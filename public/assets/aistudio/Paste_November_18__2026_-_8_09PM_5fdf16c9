  const formulaExplanation = document.getElementById('formulaExplanation');
  const chevron = document.getElementById('formulaChevron');

  if (toggleBtn && formulaExplanation && chevron) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = formulaExplanation.classList.contains('hidden');
      if (isHidden) {
        formulaExplanation.classList.remove('hidden');
        chevron.style.transform = 'rotate(180deg)';
      } else {
        formulaExplanation.classList.add('hidden');
        chevron.style.transform = 'rotate(0deg)';
      }
    });
  }

  // Textile Conservation Protocol Tabs
  const tabLinen = document.getElementById('tabLinen');
  const tabPlastic = document.getElementById('tabPlastic');
  const contentLinen = document.getElementById('contentLinen');
  const contentPlastic = document.getElementById('contentPlastic');

  if (tabLinen && tabPlastic && contentLinen && contentPlastic) {
    tabLinen.addEventListener('click', () => {
      tabLinen.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
      tabLinen.classList.remove('text-on-surface-variant');
      tabPlastic.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
      tabPlastic.classList.add('text-on-surface-variant');

      contentLinen.classList.remove('hidden');
      contentPlastic.classList.add('hidden');
    });

    tabPlastic.addEventListener('click', () => {
      tabPlastic.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
      tabPlastic.classList.remove('text-on-surface-variant');
      tabLinen.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
      tabLinen.classList.add('text-on-surface-variant');

      contentPlastic.classList.remove('hidden');
      contentLinen.classList.add('hidden');
    });
  }

  // Feedback on GDPR Download Button
  const exportBtn = document.getElementById('exportGdprBtn');
  if (exportBtn) {
