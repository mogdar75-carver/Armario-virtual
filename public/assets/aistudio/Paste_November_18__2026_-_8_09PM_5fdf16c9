      const originalHtml = exportBtn.innerHTML;
      exportBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">sync</span><span>Generando Archivo Cifrado...</span>';
      setTimeout(() => {
        exportBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] text-primary">check_circle</span><span>Informe Exportado Exitosamente</span>';
        setTimeout(() => {
          exportBtn.innerHTML = originalHtml;
        }, 3000);
      }, 1000);
    });
  }
