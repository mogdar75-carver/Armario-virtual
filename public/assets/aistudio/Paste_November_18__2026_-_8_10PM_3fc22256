<script>
  // Simple micro-interactions for tactile canvas delight
  (function initCanvasStudio() {
    const items = document.querySelectorAll('.canvas-item');
    const magnetGuide = document.getElementById('magnet-guide');
    let activeItem = null;
    let startX = 0, startY = 0;
    let initialX = 0, initialY = 0;
    let rotations = { 'layer-0': -1.5, 'layer-1': 0.8, 'layer-2': -0.5, 'layer-3': 3.0 };

    items.forEach(item => {
      // Tap to rotate 45 degrees
      item.addEventListener('click', (e) => {
        const id = item.id;
        rotations[id] = (rotations[id] + 45) % 360;
        const currentTransform = item.style.transform;
        const scaleMatch = currentTransform.match(/scale\(([^)]+)\)/);
        const scale = scaleMatch ? scaleMatch[1] : '1';
        item.style.transform = `scale(${scale}) rotate(${rotations[id]}deg)`;
        
        // Brief pulse effect
        if (magnetGuide) {
          magnetGuide.classList.remove('opacity-0');
          setTimeout(() => magnetGuide.classList.add('opacity-0'), 400);
        }
      });
    });

    // Segmented tab switch feel
    const tabCanvas = document.getElementById('tab-canvas');
    const tabTravel = document.getElementById('tab-travel');

    if (tabCanvas && tabTravel) {
      tabCanvas.addEventListener('click', () => {
        tabCanvas.className = "flex-1 py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-200 bg-surface-container-lowest text-on-surface shadow-sm font-semibold flex items-center justify-center gap-1.5";
        tabTravel.className = "flex-1 py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-200 text-secondary hover:text-on-surface flex items-center justify-center gap-1.5";
      });

      tabTravel.addEventListener('click', () => {
        tabTravel.className = "flex-1 py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-200 bg-surface-container-lowest text-on-surface shadow-sm font-semibold flex items-center justify-center gap-1.5";
        tabCanvas.className = "flex-1 py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-200 text-secondary hover:text-on-surface flex items-center justify-center gap-1.5";
      });
    }

    // Floating actions delight feedback
    const centerBtn = document.getElementById('tool-center');
    if (centerBtn) {
      centerBtn.addEventListener('click', () => {
        items.forEach(el => {
          el.style.transform = 'scale(1) rotate(0deg)';
        });
      });
    }

    const flipBtn = document.getElementById('tool-flip');
    if (flipBtn) {
      flipBtn.addEventListener('click', () => {
        items.forEach(el => {
          if (el.style.transform.includes('scaleX(-1)')) {
            el.style.transform = el.style.transform.replace('scaleX(-1)', 'scaleX(1)');
          } else {
            el.style.transform += ' scaleX(-1)';
          }
        });
      });
    }
  })();
