<span class="material-symbols-outlined text-[18px] text-tertiary">bookmark_add</span>
<span>Guardar en Lookbook</span>
</button>
</div>
</section>
<!-- REPUTATION / IMPACT MICRO NOTIFICATION (Appears after registration) -->
<div class="fixed bottom-20 left-4 right-4 z-40 hidden transition-all duration-300 transform translate-y-4" id="toast-wear-success">
<div class="bg-inverse-surface text-inverse-on-surface p-space-sm rounded-xl shadow-xl flex items-center justify-between">
<div class="flex items-center gap- space-sm">
<span class="material-symbols-outlined text-primary-fixed-dim text-[22px]">verified</span>
<div>
<p class="font-label-md text-label-md font-semibold">Uso Registrado con Éxito</p>
<p class="font-body-sm text-body-sm opacity-90 text-[11px]">+4 prendas actualizadas. CPW optimizado en un -2.4%.</p>
</div>
</div>
<button class="p-1 text-inverse-on-surface/80 hover:text-inverse-on-surface" onclick="document.getElementById('toast-wear-success').classList.add('hidden')">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
</div>
<script>
    // Micro-interactions for AI Outfit Page
    const wearTodayBtn = document.getElementById('wear-today-btn');
    const toast = document.getElementById('toast-wear-success');
    const toggleEveningBtn = document.getElementById('toggle-evening-btn');
    const swapBtn = document.getElementById('swap-piece-btn');
    const saveBtn = document.getElementById('save-lookbook-btn');
    const likeBtn = document.getElementById('feedback-like');
    const dislikeBtn = document.getElementById('feedback-dislike');

    // Registration feedback
    wearTodayBtn.addEventListener('click', () => {
      wearTodayBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] text-emerald-300">task_alt</span><span>¡Guardado para Hoy!</span>';
      wearTodayBtn.classList.remove('bg-on-background');
      wearTodayBtn.classList.add('bg-primary');
      
      toast.classList.remove('hidden', 'translate-y-4');
      toast.classList.add('translate-y-0');

      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4200);
    });

    // Evening Toggle Preview
    let eveningState = false;
    toggleEveningBtn.addEventListener('click', () => {
      eveningState = !eveningState;
      if (eveningState) {
        toggleEveningBtn.innerText = 'Restaurar';
        toggleEveningBtn.classList.add('bg-secondary', 'text-on-secondary');
      } else {
        toggleEveningBtn.innerText = 'Previsualizar';
        toggleEveningBtn.classList.remove('bg-secondary', 'text-on-secondary');
      }
    });

    // Quick AI Swap piece toast/feedback
    swapBtn.addEventListener('click', () => {
      const originalText = swapBtn.innerHTML;
      swapBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px] text-primary">progress_activity</span><span>Buscando...</span>';
      setTimeout(() => {
        swapBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] text-primary">done</span><span>Suéter renovado</span>';
        setTimeout(() => { swapBtn.innerHTML = originalText; }, 1800);
      }, 700);
    });

    // Save to Lookbook feedback
    saveBtn.addEventListener('click', () => {
      saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] text-tertiary" style="font-variation-settings:\'FILL\' 1">bookmark_check</span><span>Guardado</span>';
    });

    // Feedback rating buttons
    likeBtn.addEventListener('click', () => {
      likeBtn.classList.add('bg-primary', 'text-on-primary');
      dislikeBtn.classList.remove('bg-error', 'text-on-error');
    });

    dislikeBtn.addEventListener('click', () => {
      dislikeBtn.classList.add('bg-error', 'text-on-error');
      likeBtn.classList.remove('bg-primary', 'text-on-primary');
    });
  </script>
