<section class="px-gutter space-y-space-sm pt-space-xs">
<!-- Primary CTA: Wear today & track usage -->
<button class="w-full h-12 bg-on-background text-surface-bright rounded-md font-label-lg text-label-lg font-semibold flex items-center justify-center gap-space-sm shadow-md active:scale-[0.99] transition-transform" id="wear-today-btn">
<span class="material-symbols-outlined text-[20px]">checkroom</span>
<span>Vestir Hoy &amp; Registrar Uso</span>
</button>
<!-- Secondary Quick Utility Row -->
<div class="grid grid-cols-2 gap-space-sm">
<button class="h-11 bg-surface-container rounded-md font-label-md text-label-md text-on-surface font-semibold flex items-center justify-center gap-1.5 active:bg-surface-container-high transition-colors" id="swap-piece-btn">
