<script>
  function triggerQuickCapture() {
    showToast('Iniciando Cámara Directa: Matting en 300ms');
  }

  function selectPipeline(name, detail) {
    showToast('Pipeline: ' + name + ' (' + detail + ')');
  }

  function filterCategory(btn, cat) {
    document.querySelectorAll('.cat-pill').forEach(function(pill) {
      pill.classList.remove('bg-on-surface', 'text-on-primary', 'shadow-sm');
      pill.classList.add('text-secondary', 'bg-surface-container-high');
    });
    btn.classList.remove('text-secondary', 'bg-surface-container-high');
    btn.classList.add('bg-on-surface', 'text-on-primary', 'shadow-sm');

    var cards = document.querySelectorAll('.garment-card');
    cards.forEach(function(card) {
      if (cat === 'all') {
        card.style.display = 'flex';
      } else {
        if (card.dataset.category === cat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      }
    });
  }

  function showToast(msg) {
    var toast = document.getElementById('action-toast');
    var text = document.getElementById('toast-text');
    if (!toast || !text) return;
    text.textContent = msg;
    toast.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(function() {
      toast.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2400);
  }
